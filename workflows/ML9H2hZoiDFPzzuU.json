    {
      "parameters": {
        "jsCode": "const msg = $input.first().json;\n\n// Gérer les callback_query (clic sur un bouton)\nif (msg.callback_query) {\n  const cb = msg.callback_query;\n  return [{\n    json: {\n      command: 'CALLBACK',\n      args: {},\n      chatId: String(cb.message?.chat?.id || ''),\n      fromUser: cb.from?.first_name || 'Utilisateur',\n      messageId: cb.message?.message_id || '',\n      callbackQueryId: cb.id || '',\n      callbackData: cb.data || '',\n      rawText: cb.data || ''\n    }\n  }];\n}\n\n// Sinon, message texte normal\nconst text     = (msg.message?.text || '').trim();\nconst textLow  = text.toLowerCase();\nconst chatId   = String(msg.message?.chat?.id || '');\nconst fromUser = msg.message?.from?.first_name || 'Utilisateur';\nconst messageId = msg.message?.message_id || '';\n\nlet command = '';\nlet args = {};\n\nconst isDriveLink = /https:\\/\\/drive\\.google\\.com\\/(file\\/d\\/|open\\?id=|drive\\/folders\\/)[a-zA-Z0-9_-]+/.test(text);\n\nif (isDriveLink) {\n  command = 'DRIVE_LINK';\n  args.driveUrl = text.trim();\n} else if (textLow.startsWith('/batch')) {\n  command = 'BATCH';\n  const parts = textLow.split(' ');\n  args.limit = parts[1] ? parseInt(parts[1]) : null;\n} else if (textLow.startsWith('/reclass')) {\n  command = 'RECLASS';\n} else if (textLow.startsWith('/status')) {\n  command = 'STATUS';\n} else if (textLow.startsWith('/stop')) {\n  command = 'STOP';\n} else if (textLow.startsWith('/help') || textLow === '/start') {\n  command = 'HELP';\n} else {\n  command = 'UNKNOWN';\n}\n\nreturn [{ json: { command, args, chatId, fromUser, messageId, rawText: text } }];"
      },
