    {
      "parameters": {
        "jsCode": "const TYPES = ['pdf','jpg','jpeg','png','heic','webp','tiff','bmp'];\nconst files = $input.first().json.files || [];\nconst chatId = $('🔍 Parser Commande').first().json.chatId;\nconst fromUser = $('🔍 Parser Commande').first().json.fromUser;\n\nconst docs = files.filter(f => {\n  const mime = f.mimeType || '';\n  const name = f.name || '';\n  if (mime === 'application/vnd.google-apps.folder') return false;\n  return TYPES.some(t => mime.includes(t))\n      || new RegExp(`\\\\.(${TYPES.join('|')})$`,'i').test(name);\n});\n\nconst totalBytes = docs.reduce((s, f) => s + parseInt(f.size || 0), 0);\nconst totalMB = (totalBytes / 1024 / 1024).toFixed(1);\n\n// Répartition par type\nconst byType = {};\ndocs.forEach(f => {\n  const ext = (f.name.split('.').pop() || '?').toLowerCase();\n  byType[ext] = (byType[ext] || 0) + 1;\n});\nconst typeLines = Object.entries(byType)\n  .sort((a,b) => b[1]-a[1])\n  .map(([ext, n]) => `  • .${ext} : ${n} fichier${n>1?'s':''}`)\n  .join('\\n');\n\nconst now = new Date().toLocaleString('fr-CA', {\n  timeZone: 'America/Toronto',\n  year: 'numeric', month: '2-digit', day: '2-digit',\n  hour: '2-digit', minute: '2-digit'\n});\n\nlet statusLine;\nif (docs.length === 0) {\n  statusLine = '✅ Dossier vide — rien à traiter.';\n} else if (docs.length <= 10) {\n  statusLine = `⚠️ ${docs.length} document${docs.length>1?'s':''} en attente.`;\n} else {\n  statusLine = `🔴 ${docs.length} documents en attente — batch recommandé.`;\n}\n\nconst msg = [\n  '<b>📊 Statut GED</b>',\n  `🕐 ${now}`,\n  '',\n  statusLine,\n  '',\n  `📄 Documents détectés : <b>${docs.length}</b>`,\n  `💾 Volume total       : <b>${totalMB} Mo</b>`,\n  '',\n  typeLines ? '<i>Répartition :</i>\\n' + typeLines : '',\n  '',\n  docs.length > 0\n    ? 'Pour lancer le traitement : /batch'\n    : 'Aucune action requise.'\n].filter(l => l !== '').join('\\n');\n\nreturn [{ json: { chatId, fromUser, msg } }];"
      },
