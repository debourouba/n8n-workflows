      "id": "0e7bf271-651a-4bd8-aaab-8363d32b712d",
      "name": "📂 Status — Lister Drive",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        -576,
        1296
      ],
