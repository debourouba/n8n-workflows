    {
      "parameters": {
        "jsCode": "const msg = $input.first().json;\nconst text = (msg.message?.text || '').trim();\nconst textLow = text.toLowerCase();\nconst chatId = msg.message?.chat?.id || '';\nconst fromUser = msg.message?.from?.first_name || 'Utilisateur';\nconst messageId = msg.message?.message_id || '';\n\nlet command = '';\nlet args = {};\n\n// Détecter lien Google Drive (CAS B reclassification)\nconst isDriveLink = /https:\\/\\/drive\\.google\\.com\\/(file\\/d\\/|open\\?id=|drive\\/folders\\/)[a-zA-Z0-9_-]+/.test(text);\n\nif (isDriveLink) {\n  command = 'DRIVE_LINK';\n  args.driveUrl = text.trim();\n} else if (textLow.startsWith('/batch')) {\n  command = 'BATCH';\n  const parts = textLow.split(' ');\n  args.limit = parts[1] ? parseInt(parts[1]) : null;\n} else if (textLow.startsWith('/reclass')) {\n  command = 'RECLASS';\n} else if (textLow.startsWith('/status')) {\n  command = 'STATUS';\n} else if (textLow.startsWith('/stop')) {\n  command = 'STOP';\n} else if (textLow.startsWith('/help') || textLow === '/start') {\n  command = 'HELP';\n} else {\n  command = 'UNKNOWN';\n}\n\nreturn [{ json: {\n  command, args,\n  chatId: String(chatId),\n  fromUser, messageId,\n  rawText: text\n} }];"
      },
