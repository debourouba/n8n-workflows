      "id": "cd75f512-0698-44ae-8b65-e0ad76d54980",
      "name": "📂 Status — Lister Drive",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        -1216,
        3888
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "r2JUysRK5UnnMMKe",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const TYPES = ['pdf','jpg','jpeg','png','heic','webp','tiff','bmp'];\nconst files = $input.first().json.files || [];\nconst chatId = $('🔍 Parser Commande').first().json.chatId;\nconst fromUser = $('🔍 Parser Commande').first().json.fromUser;\n\nconst docs = files.filter(f => {\n  const mime = f.mimeType || '';\n  const name = f.name || '';\n  if (mime === 'application/vnd.google-apps.folder') return false;\n  return TYPES.some(t => mime.includes(t)) || new RegExp(`\\\\.(${TYPES.join('|')})$`,'i').test(name);\n});\n\nconst totalBytes = docs.reduce((s, f) => s + parseInt(f.size || 0), 0);\nconst totalMB = (totalBytes / 1024 / 1024).toFixed(1);\n\nconst byType = {};\ndocs.forEach(f => { const ext = (f.name.split('.').pop() || '?').toLowerCase(); byType[ext] = (byType[ext] || 0) + 1; });\nconst typeLines = Object.entries(byType).sort((a,b) => b[1]-a[1]).map(([ext, n]) => `  • .${ext} : ${n} fichier${n>1?'s':''}`).join('\\n');\n\nconst now = new Date().toLocaleString('fr-CA', { timeZone: 'America/Toronto', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' });\n\nlet statusLine;\nif (docs.length === 0) statusLine = '✅ Dossier vide — rien à traiter.';\nelse if (docs.length <= 10) statusLine = `⚠️ ${docs.length} document${docs.length>1?'s':''} en attente.`;\nelse statusLine = `🔴 ${docs.length} documents en attente — batch recommandé.`;\n\nconst msg = ['<b>📊 Statut GED</b>', `🕐 ${now}`, '', statusLine, '', `📄 Documents détectés : <b>${docs.length}</b>`, `💾 Volume total       : <b>${totalMB} Mo</b>`, '', typeLines ? '<i>Répartition :</i>\\n' + typeLines : '', '', docs.length > 0 ? 'Pour lancer le traitement : /batch' : 'Aucune action requise.'].filter(l => l !== '').join('\\n');\n\nreturn [{ json: { chatId, fromUser, msg } }];"
      },
