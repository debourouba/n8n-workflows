        "jsCode": "const fullPath = $json.path || \"\"; \nconst parts = fullPath.split(/[\\\\/]/);\n// Utiliser folderName directement au lieu de parser path\nconst folderName = $('Edit Fields').first().json.folderName || \"\";\n\nconst regex = /(\\d{4}-\\d{2}-\\d{2})\\s+(\\d{2}\\.\\d{2}\\.\\d{2})\\s+(.*?)\\s+et\\s+Djamel/;\nconst match = folderName.match(regex);\n\nreturn [{\n  json: {\n    date: match ? match[1] : \"Inconnue\",\n    time: match ? match[2].replace(/\\./g, \":\") : \"Inconnue\",\n    prospectName: match ? match[3].trim() : \"Inconnu\",\n    folderId: $json.folderId,\n    folderName: folderName\n  }\n}];"
