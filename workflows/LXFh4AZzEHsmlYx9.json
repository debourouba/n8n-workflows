      "parameters": {
        "jsCode": "const results = $input.all();\nreturn results.map(r => ({\n  json: {\n    dealId: r.json.id,\n    status: r.json.status,\n    ownerId: r.json.owner?.id,\n    personId: r.json.person?.id,\n    personName: r.json.person?.name,\n    stageName: r.json.stage?.name || \"Inconnue\"\n  }\n}));"
      },
