        "jsCode": "// ============================================================\n// Scan de TOUS les dossiers Zoom du même prospect (toutes dates confondues)\n// Même logique pour le lancement manuel et la détection automatique\n// (les deux passent par ce lanceur).\n// ============================================================\nconst MAX_GAP_DAYS = null;   // null = aucune limite de dates. Ex: 14 → ignore les dossiers à plus de 14 jours du dossier déclencheur\n\nconst trig = $('Extraction Nom Prospect').first().json;   // folderId, folderName, prospectName, date, time\nconst NAME_RE = /^(\\d{4}-\\d{2}-\\d{2})\\s+(\\d{2}[.:]\\d{2}[.:]\\d{2})\\s+(.*?)\\s+(?:avec|et)\\s+.+$/i;\n\nconst norm = s => String(s || '').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase();\nconst tokens = s => new Set(norm(s).split(/\\s+/).filter(t => t.length >= 2));\nfunction sameProspect(a, b) {\n  const A = tokens(a), B = tokens(b);\n  if (!A.size || !B.size) return false;\n  if (A.size === B.size && [...A].every(t => B.has(t))) return true;       // mêmes mots (ex: \"Sophie Sophie Joli-Coeur\" = \"Sophie Joli-Coeur\")\n  const [small, big] = A.size <= B.size ? [A, B] : [B, A];\n  return small.size >= 2 && [...small].every(t => big.has(t));              // un prénom seul est trop ambigu\n}\n\nconst triggerTs = /^\\d{4}-\\d{2}-\\d{2}$/.test(trig.date || '') ? Date.parse(trig.date + 'T00:00:00Z') : null;\nconst picked = new Map();\n\nfor (const f of $input.all().map(i => i.json)) {\n  if (!f || !f.id || !f.name) continue;\n  const m = String(f.name).match(NAME_RE);\n  if (!m) continue;\n  const isTrigger = f.id === trig.folderId;\n  if (!isTrigger && !sameProspect(m[3], trig.prospectName)) continue;\n  if (!isTrigger && MAX_GAP_DAYS != null && triggerTs != null) {\n    const gap = Math.abs(Date.parse(m[1] + 'T00:00:00Z') - triggerTs) / 86400000;\n    if (gap > MAX_GAP_DAYS) continue;\n  }\n  picked.set(f.id, { id: f.id, name: f.name, date: m[1], time: m[2].replace(/\\./g, ':'), is_trigger: isTrigger });\n}\n\n// Garantie : le dossier déclencheur est toujours inclus (même si absent de la liste ou nom non conforme)\nif (!picked.has(trig.folderId))\n  picked.set(trig.folderId, { id: trig.folderId, name: trig.folderName, date: trig.date, time: trig.time, is_trigger: true });\n\nconst folders = [...picked.values()]\n  .sort((a, b) => String(a.name).localeCompare(String(b.name)));   // ordre chronologique (préfixe AAAA-MM-JJ HH.MM.SS)\n\n// UN seul item en sortie (la liste est dans json.folders) + pairedItem explicite :\n// sans lui, n8n ne peut plus remonter aux nœuds amont ($('...').item) quand il y a plusieurs dossiers.\nreturn [{ json: { folders, count: folders.length, prospectName: trig.prospectName }, pairedItem: { item: 0 } }];\n"
      },
