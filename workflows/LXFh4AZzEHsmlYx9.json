      "name": "Split Deals"
    },
    {
      "parameters": {
        "jsCode": "const stageMap = {};\n($('Get All Stages').first().json.data || []).forEach(s => {\n  stageMap[s.id] = s.name;\n});\n\nconst MY_OWNER_ID = 22028817;\nconst items = $input.all();\n\n// Récupérer stageName depuis Split Deals via Pipedrive Search original\n// Non disponible ici — utiliser stage_id en fallback\nconst enriched = items.map(r => {\n  const deal = r.json.data || {};\n\n  const ownerId = deal.user_id?.id ?? null;\n  const ownerName = deal.user_id?.name ?? \"Inconnu\";\n  const personId = deal.person_id?.value ?? null;\n  const personName = deal.person_id?.name ?? null;\n\n  const lostTime = deal.lost_time\n    ? new Date(deal.lost_time).toLocaleDateString('fr-CA', {\n        year: 'numeric', month: 'long', day: 'numeric'\n      })\n    : null;\n\n  return {\n    dealId: deal.id,\n    status: deal.status,\n    ownerId,\n    ownerName,\n    personId,\n    personName,\n    stage: r.json.related_objects?.stage?.[deal.stage_id]?.name || deal.stage_id || \"Inconnue\",\n    lostTime,\n    lostReason: deal.lost_reason || null,\n    isMe: ownerId === MY_OWNER_ID\n  };\n});\n\nconst myDeal = enriched.find(d => d.isMe && d.status === \"open\");\nconst otherOpenDeals = enriched.filter(d => !d.isMe && d.status === \"open\");\nconst inactiveDeals = enriched.filter(d => !d.isMe && d.status !== \"open\");\n\nconst scenario = !myDeal ? \"not_found\"\n  : otherOpenDeals.length > 0 ? \"duplicate_active\"\n  : \"success\";\n\nreturn [{\n  json: {\n    scenario,\n    myDeal,\n    personId: myDeal?.personId || null,\n    personName: myDeal?.personName || null,\n    otherOpenDeals,\n    inactiveDeals,\n    totalFound: enriched.length\n  }\n}];"
      },
