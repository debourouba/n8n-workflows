        "jsCode": "const triggerData = $('When Executed by Another Workflow').first().json;\nconst folderName  = triggerData.name || \"\";\nconst folderId    = triggerData.id   || \"\";\n\nconst regex = /^(\\d{4}-\\d{2}-\\d{2})\\s+(\\d{2}[.:]\\d{2}[.:]\\d{2})\\s+(.*?)\\s+(?:avec|et)\\s+.+$/i;\nconst match  = folderName.match(regex);\n\nif (!match) {\n  console.log(\"[Extraction] no match sur: \" + folderName);\n}\n\nreturn [{\n  json: {\n    date:         match ? match[1]                     : \"Inconnue\",\n    time:         match ? match[2].replace(/\\./g, \":\") : \"Inconnue\",\n    prospectName: match ? match[3].trim()              : \"Inconnu\",\n    folderId,\n    folderName\n  }\n}];"
      },
