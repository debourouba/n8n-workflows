    {
      "parameters": {
        "jsCode": "// Purge _HASH_LOCK — filtrer entrées > 90 jours (v4 sans $helpers)\nconst THRESHOLD = 90;\nconst now = DateTime.now().setZone('America/Toronto');\nconst rows = $input.first().json.values || [];\n\nif (rows.length <= 1) {\n  return [{ json: { purged: 0, kept: 0, toKeep: [rows[0] || []], message: 'Aucune entrée' } }];\n}\n\nconst header   = rows[0];\nconst dataRows = rows.slice(1);\nconst toKeep   = [header];\nlet purgedCount = 0;\n\nfor (const row of dataRows) {\n  const tsRaw = row[1] || '';\n  if (!tsRaw) { toKeep.push(row); continue; }\n  const ts = DateTime.fromISO(tsRaw).setZone('America/Toronto');\n  if (!ts.isValid) { toKeep.push(row); continue; }\n  const ageDays = now.diff(ts, 'days').days;\n  if (ageDays <= THRESHOLD) { toKeep.push(row); } else { purgedCount++; }\n}\n\nreturn [{ json: { purged: purgedCount, kept: toKeep.length - 1, toKeep, message: `${purgedCount} supprimées, ${toKeep.length-1} conservées` } }];"
      },
