        "microsoftOneDriveOAuth2Api": {
          "id": "63wYday4djuJaioz",
          "name": "Microsoft Drive account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const folderName = $('Form — Nom du dossier').first().json.folderName.trim().toLowerCase();\nconst items = $json.value;\n\nif (!items || items.length === 0) {\n  throw new Error('Aucun contenu dans /!Documents/Zoom');\n}\n\n// Filtrer dossiers uniquement + match partiel sur le nom\nconst folders = items.filter(i =>\n  i.folder !== undefined &&\n  i.name.toLowerCase().includes(folderName)\n);\n\nif (folders.length === 0) {\n  throw new Error('Aucun dossier trouvé pour: ' + folderName);\n}\n\n// Prendre le premier match\nconst folder = folders[0];\nconst parentPath = folder.parentReference && folder.parentReference.path\n  ? folder.parentReference.path\n  : '/drive/root:/%21Documents/Zoom';\n\nreturn [{\n  json: {\n    id: folder.id,\n    name: folder.name,\n    path: parentPath + '/' + folder.name,\n    manual: true\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
