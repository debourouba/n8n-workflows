    {
      "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567897",
      "name": "Process Invoice Sheet",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        1500,
        100
      ],
      "parameters": {
        "language": "javaScript",
        "code": "const XLSX = require('xlsx');\n\n// Récupérer le fichier Excel binaire en entrée\nconst binaryData = items[0].binary.data;\nconst wb = XLSX.read(binaryData, { type: 'buffer', cellDates: true });\n\n// Récupérer les données des nœuds précédents\nconst getDealsData = $node['Get Deals'].json;\nconst stageName = $node['Manual Trigger'].json.stageName;\nconst prospects = getDealsData.map(deal => deal.title);\n\n// Extraire la date du format \"Cohorte XX (25 juin)\"\nconst dateMatch = stageName.match(/\\(([^)]+)\\)/);\nif (!dateMatch) throw new Error('Format de stageName invalide');\nconst dateStr = dateMatch[1].trim();\n\nconst [dayStr, monthFr] = dateStr.split(' ');\nconst day = parseInt(dayStr);\n\nconst frenchMonths = ['janvier','février','mars','avril','mai','juin','juillet','août','septembre','octobre','novembre','décembre'];\nconst monthIndex = frenchMonths.findIndex(m => m === monthFr.toLowerCase());\nif (monthIndex === -1) throw new Error('Mois français invalide');\n\nconst currentDate = new Date();\nlet year = currentDate.getFullYear();\nif (monthIndex === 11 && currentDate.getMonth() === 0) {\n  year--;\n}\n\nconst startDate = new Date(year, monthIndex, day);\n\n// Extraire le numéro de cohorte du nom du stage\nconst cohortNumber = stageName.match(/\\d+/)[0];\n\n// 1. Identifier le dernier onglet Fact.XXXXX\nconst factSheets = wb.SheetNames.filter(name => /^Fact\\.\\s20\\d{5}$/.test(name));\nif (factSheets.length === 0) throw new Error('Aucun onglet Facture trouvé');\n\n// Trier par numéro décroissant\nfactSheets.sort((a, b) => {\n  const numA = parseInt(a.split(' ')[1].substring(4));\n  const numB = parseInt(b.split(' ')[1].substring(4));\n  return numB - numA;\n});\nconst lastSheetName = factSheets[0];\nconst lastSheet = wb.Sheets[lastSheetName];\n\n// 2. Vérifier si la cohorte est déjà facturée\nconst lastCohorteCell = lastSheet['A25'];\nif (lastCohorteCell && lastCohorteCell.v) {\n  const match = lastCohorteCell.v.match(/Cohorte #(\\d+)/);\n  if (match && parseInt(match[1]) >= parseInt(cohortNumber)) {\n    throw new Error(`Cohorte ${cohortNumber} déjà facturée ou hors séquence`);\n  }\n}\n\n// 3. Préparer le nouvel onglet\nconst lastInvoiceNumber = parseInt(lastSheetName.split(' ')[1].substring(4));\nconst nextInvoiceNumber = lastInvoiceNumber + 1;\nconst year = new Date().getFullYear();\nconst nextInvoiceNumberPadded = String(nextInvoiceNumber).padStart(3, '0');\nconst newInvoiceNumber = `${year}${nextInvoiceNumberPadded}`;\nconst newSheetName = `Fact. ${newInvoiceNumber}`;\n\n// 4. Copier le dernier onglet\nwb.SheetNames.push(newSheetName);\nconst newSheet = JSON.parse(JSON.stringify(lastSheet));\nwb.Sheets[newSheetName] = newSheet;\n\n// 5. Mettre à jour les cellules spécifiques\n// - Numéro de facture (H2)\nwb.Sheets[newSheetName]['H2'] = { t: 's', v: `Facture nº ${newInvoiceNumber}` };\n\n// - Date d'émission (H4)\nconst invoiceDate = new Date(startDate);\ninvoiceDate.setDate(invoiceDate.getDate() + 1);\nconst formattedDate = invoiceDate.toISOString().split('T')[0];\nwb.Sheets[newSheetName]['H4'] = { t: 's', v: formattedDate };\n\n// - Numéro de cohorte (A25)\nwb.Sheets[newSheetName]['A25'] = { t: 's', v: `ENROUTE Cohorte #${cohortNumber}` };\n\n// - Liste des prospects (A27:A46)\n// Effacer les anciennes valeurs\nfor (let i = 27; i <= 46; i++) {\n  const cell = `A${i}`;\n  delete wb.Sheets[newSheetName][cell];\n}\n\n// Écrire les nouveaux noms\nprospects.forEach((prospect, i) => {\n  if (i < 20) {\n    const cell = `A${27 + i}`;\n    wb.Sheets[newSheetName][cell] = { t: 's', v: prospect };\n  }\n});\n\n// 6. Exporter le workbook mis à jour\nconst updatedBinary = XLSX.write(wb, { bookType: 'xlsx', type: 'buffer' });\n\n// 7. Retourner les données pour les nœuds suivants\nreturn [{\n  json: {\n    invoiceNumber: newInvoiceNumber,\n    cohorte: cohortNumber,\n    totalAmount: prospects.length * 150,\n    prospectsCount: prospects.length,\n    sheetName: newSheetName,\n    year: year\n  },\n  binary: {\n    data: updatedBinary\n  }\n}];"
      }
