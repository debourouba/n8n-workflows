    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst chatId = input.chatId || '';\nconst fromUser = input.fromUser || '';\nconst rawUrl = input.driveUrl || input.rawText || '';\n\n// Extraire fileId du lien Drive\n// Formats: /file/d/ID/view  ou  id=ID\nlet fileId = '';\nconst m1 = rawUrl.match(/\\/file\\/d\\/([a-zA-Z0-9_-]+)/);\nconst m2 = rawUrl.match(/[?&]id=([a-zA-Z0-9_-]+)/);\nif (m1) fileId = m1[1];\nelse if (m2) fileId = m2[1];\n\nif (!fileId) throw new Error('Impossible d\\'extraire le fileId du lien: ' + rawUrl);\n\nreturn [{ json: { chatId, fromUser, fileId, source: 'LIEN_DRIVE' } }];"
      },
      "id": "03e870fc-e882-4542-a512-f07f0fdb8681",
