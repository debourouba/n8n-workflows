    {
      "parameters": {
        "jsCode": "const d = $('⚙️ Calculer Destination').first().json;\nconst icones = { GED: '🗄️', FISCAL: '📊', DOUBLON: '🔄', MIXTE: '🔀' };\nconst icoNew = icones[d.nouvelleNature] || '📄';\nconst icoOld = icones[d.ancienneNature] || '📄';\n\nconst msg = [\n  `✅ <b>Reclassifié avec succès</b>`,\n  '',\n  `📄 ${d.fileName}`,\n  `${icoOld} ${d.ancienneNature}  →  ${icoNew} <b>${d.nouvelleNature}</b>`,\n  '',\n  d.source === 'RECLASS_BOT'\n    ? '_Tape /reclass pour le document suivant._'\n    : '_Correction enregistrée. Colle un autre lien si nécessaire._'\n].join('\\n');\n\nreturn [{ json: { chatId: d.chatId, msg } }];"
      },
