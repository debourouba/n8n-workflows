    {
      "parameters": {
        "jsCode": "// Fusionner les deux branches (lien Drive OU file reclass)\n// L'une ou l'autre aura fourni fileId + chatId\nconst fromLien = (() => { try { return $('🔗 Extraire FileId du Lien').first().json; } catch(e) { return null; } })();\nconst fromFile = (() => { try { const d = $('🗂️ Construire File Reclass').first().json; return d.vide ? null : d; } catch(e) { return null; } })();\n\nconst d = fromLien || fromFile;\nif (!d || !d.fileId) throw new Error('Aucun fileId disponible');\n\nreturn [{ json: {\n  chatId: d.chatId,\n  fromUser: d.fromUser,\n  fileId: d.fileId,\n  fileName: d.fileName || '',\n  natureActuelle: d.natureActuelle || '',\n  confiance: d.confiance || '',\n  raisonDoute: d.raisonDoute || '',\n  lienDrive: d.lienDrive || 'https://drive.google.com/file/d/' + d.fileId + '/view',\n  source: d.source || 'LIEN_DRIVE',\n  fileEnAttente: d.fileEnAttente || 0,\n  rowIndex: d.rowIndex || 0\n} }];"
      },
