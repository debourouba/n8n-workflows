    {
      "parameters": {
        "jsCode": "const cb = $('🔍 Parser Callback').first().json;\nconst row = $input.first().json || {};\n\nconst fileId         = cb.fileId;\nconst nouvelleNature = cb.nouvelleNature;\nconst ancienneNature = row.Nature_Finale || 'INCONNU';\nconst fileName       = row.File_Name || '';\nconst lienDrive      = row.Lien_Drive || '';\nconst confiance      = row.Confiance  || '';\nconst rowIndex       = cb.rowIndex;\n\n// Mapping nature → variable d'env du dossier Drive destination\nconst folderEnv = {\n  GED:     '$env.GED_ARCHIVE_FOLDER_ID',\n  FISCAL:  '$env.GED_FISCAL_FOLDER_ID',\n  DOUBLON: '$env.GED_DOUBLON_FOLDER_ID',\n  MIXTE:   '$env.GED_MIXTE_FOLDER_ID'\n};\n\nconst now = new Date().toLocaleString('fr-CA', { timeZone: 'America/Toronto' });\n\nreturn [{ json: {\n  chatId: cb.chatId,\n  fromUser: cb.fromUser,\n  fileId, fileName, lienDrive,\n  ancienneNature, nouvelleNature,\n  confiance, rowIndex,\n  source: cb.source,\n  tsCorrection: now,\n  folderDestEnvKey: folderEnv[nouvelleNature] || folderEnv['GED']\n} }];"
      },
