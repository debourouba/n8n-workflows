        "googleSheetsOAuth2Api": {
          "id": "vrbVsr9Llc3c8jt0",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const ctx = $('⚙️ Fusionner Contexte').first().json;\nconst row = $input.first().json || {};\n\n// Priorité : données Sheets > données passées en paramètre\nconst natureActuelle = row.Nature_Finale || ctx.natureActuelle || 'INCONNU';\nconst confiance      = row.Confiance     || ctx.confiance     || '?';\nconst raisonDoute    = row.Raison_Doute  || ctx.raisonDoute   || '';\nconst fileName       = row.File_Name     || ctx.fileName      || '(sans nom)';\nconst lienDrive      = row.Lien_Drive    || ctx.lienDrive     || '';\nconst rowIndex       = ctx.rowIndex      || 0;\n\n// Icônes par nature\nconst icones = { GED: '🗄️', FISCAL: '📊', DOUBLON: '🔄', MIXTE: '🔀', INCONNU: '❓' };\nconst ico = icones[natureActuelle] || '📄';\n\n// Badge confiance\nconst conf = confiance.toUpperCase();\nconst badgeConf = conf === 'HAUTE' ? '🟢 HAUTE' : conf === 'MOYENNE' ? '🟡 MOYENNE' : conf === 'BASSE' ? '🔴 BASSE' : '⚪ ?';\n\n// File restante\nconst enAttente = ctx.fileEnAttente || 0;\nconst fileInfo  = enAttente > 1 ? `\\n📋 <i>${enAttente} documents en file</i>` : '';\n\nconst msgFiche = [\n  '<b>🔁 Reclassification</b>',\n  '',\n  `📄 <b>${fileName}</b>`,\n  `${ico} Classé actuellement : <b>${natureActuelle}</b>`,\n  `🤖 Confiance IA : ${badgeConf}`,\n  raisonDoute ? `💬 Note IA : <i>${raisonDoute}</i>` : '',\n  `🔗 <a href='${lienDrive}'>Ouvrir dans Drive</a>`,\n  fileInfo,\n  '',\n  '👇 <b>Choisir la bonne catégorie :</b>'\n].filter(l => l !== '').join('\\n');\n\n// Payload des boutons : fileId|nouvelleNature|rowIndex|source\nconst payload = (nature) => `${ctx.fileId}|${nature}|${rowIndex}|${ctx.source}`;\n\nconst inlineKeyboard = [\n  [\n    { text: '🗄️ GED',      callback_data: payload('GED') },\n    { text: '📊 FISCAL',   callback_data: payload('FISCAL') }\n  ],\n  [\n    { text: '🔄 DOUBLON',  callback_data: payload('DOUBLON') },\n    { text: '🔀 MIXTE',    callback_data: payload('MIXTE') }\n  ],\n  [\n    { text: '⏭️ Passer',   callback_data: payload('SKIP') },\n    { text: '🛑 Terminer', callback_data: payload('STOP') }\n  ]\n];\n\nreturn [{ json: {\n  chatId: ctx.chatId,\n  fromUser: ctx.fromUser,\n  fileId: ctx.fileId,\n  fileName, natureActuelle, confiance, lienDrive, rowIndex,\n  source: ctx.source,\n  msgFiche,\n  inlineKeyboard: JSON.stringify({ inline_keyboard: inlineKeyboard })\n} }];"
      },
