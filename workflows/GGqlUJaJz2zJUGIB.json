      "id": "18f224b5-2b84-4f9d-a537-b57fd48254ef",
      "name": "📋 Lire _REVUE_BATCH",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        0,
        208
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "vrbVsr9Llc3c8jt0",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const input = $('🔗 Trigger — Commander').first().json;\nconst chatId = input.chatId || $env.GED_TELEGRAM_CHAT_ID || '';\nconst fromUser = input.fromUser || 'Utilisateur';\n\nconst rows = $input.all().map(i => i.json);\nconst file = rows.filter(r =>\n  ['VALIDER','VENTILER'].includes((r.Action_Requise || '').toUpperCase())\n  && r.File_Id\n);\n\nif (file.length === 0) {\n  return [{ json: {\n    chatId, fromUser,\n    vide: true,\n    msg: '✅ <b>Aucun document en attente de validation.</b>\\n\\nTous les documents ont été classés avec confiance haute.\\nPour corriger un doc spécifique, colle son lien Drive dans ce chat.'\n  }}];\n}\n\n// Prendre le premier de la file\nconst doc = file[0];\nreturn [{ json: {\n  chatId, fromUser,\n  vide: false,\n  fileId: doc.File_Id,\n  fileName: doc.File_Name || '(sans nom)',\n  natureActuelle: doc.Nature_Finale || '?',\n  confiance: doc.Confiance || '?',\n  raisonDoute: doc.Raison_Doute || '',\n  lienDrive: doc.Lien_Drive || '',\n  source: 'RECLASS_BOT',\n  fileEnAttente: file.length,\n  rowIndex: rows.findIndex(r => r.File_Id === doc.File_Id) + 2\n} }];"
      },
