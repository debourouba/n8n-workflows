    {
      "parameters": {
        "jsCode": "const cb = $input.first().json.callback_query;\nconst chatId = String(cb?.message?.chat?.id || '');\nconst fromUser = cb?.from?.first_name || 'Utilisateur';\nconst data = cb?.data || '';\nconst callbackQueryId = cb?.id || '';\nconst messageId = cb?.message?.message_id || '';\n\n// Payload: fileId|nouvelleNature|rowIndex|source\nconst parts = data.split('|');\nconst fileId        = parts[0] || '';\nconst nouvelleNature = parts[1] || '';\nconst rowIndex      = parseInt(parts[2] || '0');\nconst source        = parts[3] || 'LIEN_DRIVE';\n\nreturn [{ json: {\n  chatId, fromUser, fileId, nouvelleNature, rowIndex, source,\n  callbackQueryId, messageId,\n  isSkip: nouvelleNature === 'SKIP',\n  isStop: nouvelleNature === 'STOP'\n} }];"
      },
