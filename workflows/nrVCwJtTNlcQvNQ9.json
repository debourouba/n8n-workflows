      "parameters": {
        "jsCode": "// ================================================\n// Nœud : Clean Email (Ciblage spécifique IMAP)\n// ================================================\n\n// 1. Récupérer les données du nœud IMAP (peu importe sa place dans le workflow)\n// On utilise .item pour s'assurer de récupérer l'élément correspondant au passage actuel\nconst emailData = $('Email Trigger (IMAP)').item.json;\n\n// 2. Récupérer les données du nœud juste avant (pour garder les IDs Pipedrive, etc.)\nconst currentItem = $input.item.json;\n\n// On récupère le texte depuis emailData\nlet rawText = emailData.textPlain || emailData.textHtml || \"\";\n\n// -------------------------------------------------\n// Étape 1 : Corriger le double encodage (mojibake)\n// -------------------------------------------------\nfunction fixMojibake(str) {\n  if (!str) return \"\";\n  try {\n    const bytes = new Uint8Array(str.length);\n    for (let i = 0; i < str.length; i++) {\n      bytes[i] = str.charCodeAt(i) & 0xFF;\n    }\n    return new TextDecoder('utf-8').decode(bytes);\n  } catch (e) {\n    return str;\n  }\n}\n\nlet fixedText = fixMojibake(rawText);\n\n// -------------------------------------------------\n// Étape 2 : Extraire le dernier message\n// -------------------------------------------------\nfunction extractLastMessage(text) {\n  if (!text) return \"\";\n  const normalizedText = text.replace(/\\r\\n/g, '\\n');\n\n  const patterns = [\n    /\\n\\s*Le\\s+.*a\\s+écrit\\s*[:\\s]/i, \n    /\\n\\s*De\\s*:\\s*.*\\n?\\s*Envoyé\\s*:/i,\n    /\\n\\s*From\\s*:\\s*.*\\n?\\s*Sent\\s*:/i,\n    /\\n\\s*---+\\s*Mail original\\s*---+/i,\n    /\\n\\s*________________________________/i,\n    /\\n\\s*On\\s+.*wrote\\s*:/i\n  ];\n\n  let splitIndex = normalizedText.length;\n  for (let i = 0; i < patterns.length; i++) {\n    const match = normalizedText.match(patterns[i]);\n    if (match && match.index < splitIndex) {\n      splitIndex = match.index;\n    }\n  }\n\n  let lastMessage = normalizedText.substring(0, splitIndex).trim();\n\n  const mobileSigs = [\n    /Envoyé de Yahoo\\s*Courriel pour iPhone/i,\n    /Envoyé de mon iPhone/i,\n    /Envoyé de mon iPad/i,\n    /Obtenir Outlook pour/i\n  ];\n\n  for (let j = 0; j < mobileSigs.length; j++) {\n    const sigMatch = lastMessage.match(mobileSigs[j]);\n    if (sigMatch) {\n      lastMessage = lastMessage.substring(0, sigMatch.index).trim();\n    }\n  }\n  return lastMessage;\n}\n\nconst lastMessage = extractLastMessage(fixedText);\n\n// -------------------------------------------------\n// Étape 3 : Préparer le HTML\n// -------------------------------------------------\nfunction escapeHTML(str) {\n  return str\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\"/g, '&quot;')\n    .replace(/'/g, '&#039;');\n}\n\nconst escapedMessage = escapeHTML(lastMessage);\nconst lastMessageHTML = `<div style=\"font-family: sans-serif; line-height: 1.5;\">${escapedMessage.replace(/\\n/g, '<br>')}</div>`;\n\n// -------------------------------------------------\n// Retourner les résultats fusionnés\n// -------------------------------------------------\nreturn {\n  ...currentItem,       // On garde les données du nœud précédent (ex: ID Pipedrive)\n  lastMessage: lastMessage,\n  lastMessageHTML: lastMessageHTML\n};"
      },
