      "parameters": {
        "jsCode": "// ================================================\n// Nœud : Clean Email (Version Ultime Anti-Doublons)\n// ================================================\n\nconst emailData = $('Email Trigger (IMAP)').first().json;\nconst currentItem = $input.item.json;\n\n// 0. Réparer l'encodage Latin-1 mal interprété en UTF-8 (Ã© → é, Ã  → à, etc.)\nfunction decodeLatin1AsUTF8(str) {\n  if (!str) return \"\";\n  str = str\n    .replace(/Ã©/g, 'é').replace(/Ã¨/g, 'è').replace(/Ãª/g, 'ê').replace(/Ã«/g, 'ë')\n    .replace(/Ã /g, 'à').replace(/Ã¢/g, 'â').replace(/Ã¤/g, 'ä')\n    .replace(/Ã´/g, 'ô').replace(/Ã¶/g, 'ö').replace(/Ã»/g, 'û').replace(/Ã¹/g, 'ù').replace(/Ã¼/g, 'ü')\n    .replace(/Ã®/g, 'î').replace(/Ã¯/g, 'ï')\n    .replace(/Ã§/g, 'ç')\n    .replace(/Å\"/g, 'œ').replace(/Ã¦/g, 'æ')\n    .replace(/Ã‰/g, 'É').replace(/Ã€/g, 'À').replace(/Ã‡/g, 'Ç').replace(/Ã\"/g, 'Ô').replace(/Ã›/g, 'Û')\n    .replace(/Ã‹/g, 'Ë').replace(/ÃŠ/g, 'Ê').replace(/Ã/g, 'Î')\n    .replace(/â€™/g, \"'\").replace(/â€œ/g, '\"').replace(/â€/g, '\"')\n    .replace(/â€\"/g, '–').replace(/â€\"/g, '—')\n    .replace(/Â«/g, '«').replace(/Â»/g, '»')\n    .replace(/Â /g, ' ')\n    // ✅ NOUVEAU : supprimer les emojis corrompus (séquences â + caractères boîtes)\n    .replace(/â[^\\s\\w,\\.!?;:'\"«»àâäéèêëîïôöùûüçœæÀÂÄÉÈÊËÎÏÔÖÙÛÜÇŒÆ-]{1,3}/g, '')\n    // ✅ NOUVEAU : supprimer tous les caractères non-imprimables résiduels\n    .replace(/[\\x00-\\x08\\x0B\\x0C\\x0E-\\x1F\\x7F]/g, '')\n    // ✅ NOUVEAU : nettoyer les espaces multiples laissés par les suppressions\n    .replace(/  +/g, ' ');\n  return str;\n}\n\n// 1. Récupérer le texte brut ou forcer la conversion du HTML\nlet rawText = emailData.textPlain || \"\";\n\nif (!rawText || rawText.trim() === \"\") {\n  let html = emailData.textHtml || \"\";\n  html = html.replace(/<style[^>]*>[\\s\\S]*?<\\/style>/gi, '');\n  html = html.replace(/<!--[\\s\\S]*?-->/g, '');\n  html = html.replace(/<br\\s*\\/?>/gi, '\\n');\n  html = html.replace(/<\\/div>/gi, '\\n');\n  html = html.replace(/<\\/p>/gi, '\\n');\n  html = html.replace(/&nbsp;/g, ' ')\n             .replace(/&rsquo;/g, \"'\")\n             .replace(/&#39;/g, \"'\")\n             .replace(/&quot;/g, '\"')\n             .replace(/&lt;/g, '<')\n             .replace(/&gt;/g, '>')\n             .replace(/&eacute;/gi, 'é')\n             .replace(/&agrave;/gi, 'à');\n  html = html.replace(/<[^>]*>/g, '');\n  rawText = html;\n}\n\n// Appliquer le décodage Latin-1 dès que possible\nrawText = decodeLatin1AsUTF8(rawText);\n\n// 2. Réparer les accents détruits par le serveur (\\ufffd)\nfunction repairBrokenFrench(str) {\n  if (!str) return \"\";\n  const char = '\\ufffd';\n  let repaired = str\n    .replace(new RegExp('Envoy' + char, 'gi'), 'Envoyé')\n    .replace(new RegExp('R' + char + 'p\\\\.', 'gi'), 'Rép.')\n    .replace(new RegExp(' ' + char + ' ', 'g'), ' à ')\n    .replace(new RegExp('\\\\n' + char + ' :', 'g'), '\\nÀ :')\n    .replace(new RegExp(char + 'poux', 'g'), 'époux')\n    .replace(new RegExp('re' + char + 'u', 'g'), 'reçu')\n    .replace(new RegExp('n\\'' + char + 'tait', 'g'), 'n\\'était')\n    .replace(new RegExp('journ' + char + 'e', 'g'), 'journée')\n    .replace(new RegExp('co' + char + 'te', 'g'), 'coûte')\n    .replace(new RegExp(char + 'ducation', 'g'), 'éducation')\n    .replace(new RegExp('d' + char + 'marre', 'g'), 'démarre')\n    .replace(new RegExp('confirm' + char + 'e', 'g'), 'confirmée')\n    .replace(new RegExp(char + 'ventuelles', 'g'), 'éventuelles')\n    .replace(new RegExp(char + 'change', 'g'), 'échange')\n    .replace(new RegExp('a ' + char + 'crit', 'g'), 'a écrit')\n    .replace(new RegExp(char, 'g'), 'é');\n  repaired = repaired.replace(/éé/g, 'é');\n  return repaired;\n}\n\nlet fixedText = repairBrokenFrench(rawText);\n\n// 3. Extraire le dernier message\nfunction extractLastMessage(text) {\n  if (!text) return \"\";\n  const normalizedText = text.replace(/\\r\\n/g, '\\n');\n  const patterns = [\n    /\\n\\s*On\\s+[\\s\\S]*?wrote\\s*[:\\s]/i,\n    /\\n\\s*Le\\s+[\\s\\S]*?a\\s+écrit\\s*[:\\s]/i,\n    /\\n\\s*De\\s*[:\\s].*\\n?\\s*Envoy.*[:\\s]/i,\n    /\\n\\s*From\\s*[:\\s].*\\n?\\s*Sent\\s*[:\\s]/i,\n    /\\n\\s*---+\\s*Mail original\\s*---+/i,\n    /\\n\\s*________________________________/i,\n    /\\n\\s*>/\n  ];\n  let splitIndex = normalizedText.length;\n  for (let i = 0; i < patterns.length; i++) {\n    const match = normalizedText.match(patterns[i]);\n    if (match && match.index < splitIndex) splitIndex = match.index;\n  }\n  let lastMessage = normalizedText.substring(0, splitIndex).trim();\n  const mobileSigs = [\n    /Envoy.* de Yahoo/i,\n    /Envoy.* de mon iPhone/i,\n    /Envoy.* de mon iPad/i,\n    /Envoy.* de mon mobile/i,\n    /Obtenir Outlook pour/i,\n    // ✂️ Signature Educfinance — combinaisons précises uniquement\n    /Djamel-Eddine\\s+Bourouba/i,\n    /Ambassadeur\\s+Educfinance/i,\n    /educfinance\\.ca/i,\n    /Chaleureusement,?\\s*\\n?\\s*Djamel/i,  // \"Chaleureusement, Djamel\"\n    /Cordialement,?\\s*\\n?\\s*Djamel/i,\n    /Au plaisir,?\\s*\\n?\\s*Djamel/i,\n  ];\n  for (let j = 0; j < mobileSigs.length; j++) {\n    const sigMatch = lastMessage.match(mobileSigs[j]);\n    if (sigMatch) {\n      lastMessage = lastMessage.substring(0, sigMatch.index).trim();\n      break;\n    }\n  }\n  return lastMessage;\n}\n\nconst lastMessage = extractLastMessage(fixedText);\n\n// 4. Préparer le HTML final pour Pipedrive\nfunction escapeHTML(str) {\n  return str\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\"/g, '&quot;')\n    .replace(/'/g, '&#039;');\n}\n\nconst escapedMessage = escapeHTML(lastMessage);\nconst lastMessageHTML = `<div style=\"font-family: sans-serif; line-height: 1.5;\">${escapedMessage.replace(/\\n/g, '<br>')}</div>`;\n\nreturn {\n  ...currentItem,\n  lastMessage: lastMessage,\n  lastMessageHTML: lastMessageHTML\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
