    {
      "parameters": {
        "jsCode": "// ================================================\n// Nœud : Clean Email (Version Ultra-Robuste)\n// ================================================\n\nconst emailData = $('Email Trigger (IMAP)').item.json;\nconst currentItem = $input.item.json;\nlet rawText = emailData.textPlain || emailData.textHtml || \"\";\n\nfunction fixMojibake(str) {\n  if (!str) return \"\";\n  try {\n    const bytes = new Uint8Array(str.length);\n    for (let i = 0; i < str.length; i++) {\n      bytes[i] = str.charCodeAt(i) & 0xFF;\n    }\n    return new TextDecoder('utf-8').decode(bytes);\n  } catch (e) { return str; }\n}\n\nlet fixedText = fixMojibake(rawText);\n\nfunction extractLastMessage(text) {\n  if (!text) return \"\";\n  \n  // Normalisation\n  const normalizedText = text.replace(/\\r\\n/g, '\\n');\n\n  // Liste de motifs de séparation améliorés\n  const patterns = [\n    // 1. \"On ... wrote:\" (Gère les sauts de ligne entre la date et le wrote)\n    /\\n\\s*On\\s+[\\s\\S]*?wrote\\s*[:\\s]/i,\n    // 2. \"Le ... a écrit :\" (Gère les sauts de ligne)\n    /\\n\\s*Le\\s+[\\s\\S]*?a\\s+écrit\\s*[:\\s]/i,\n    // 3. Détection des chevrons de citation (Le plus efficace pour les réponses)\n    /\\n\\s*>/,\n    // 4. Headers standards Outlook/Gmail\n    /\\n\\s*De\\s*:\\s*.*\\n?\\s*Envoyé\\s*:/i,\n    /\\n\\s*From\\s*:\\s*.*\\n?\\s*Sent\\s*:/i,\n    // 5. Séparateurs horizontaux\n    /\\n\\s*---+\\s*Mail original\\s*---+/i,\n    /\\n\\s*________________________________/i\n  ];\n\n  let splitIndex = normalizedText.length;\n\n  for (let i = 0; i < patterns.length; i++) {\n    const match = normalizedText.match(patterns[i]);\n    if (match && match.index < splitIndex) {\n      splitIndex = match.index;\n    }\n  }\n\n  let lastMessage = normalizedText.substring(0, splitIndex).trim();\n\n  // Nettoyage des signatures mobiles\n  const mobileSigs = [\n    /Envoyé de Yahoo\\s*Courriel pour iPhone/i,\n    /Envoyé de mon iPhone/i,\n    /Envoyé de mon iPad/i,\n    /Obtenir Outlook pour/i,\n    /Chaleureusement,/i // Optionnel : si tu veux couper juste avant ta signature auto\n  ];\n\n  for (let j = 0; j < mobileSigs.length; j++) {\n    const sigMatch = lastMessage.match(mobileSigs[j]);\n    if (sigMatch) {\n      // On ne coupe que si la signature est vers la fin du message\n      if (sigMatch.index > lastMessage.length * 0.7) {\n         // lastMessage = lastMessage.substring(0, sigMatch.index).trim();\n      }\n    }\n  }\n\n  return lastMessage;\n}\n\nconst lastMessage = extractLastMessage(fixedText);\n\nfunction escapeHTML(str) {\n  return str\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\"/g, '&quot;')\n    .replace(/'/g, '&#039;');\n}\n\nconst escapedMessage = escapeHTML(lastMessage);\nconst lastMessageHTML = `<div style=\"font-family: sans-serif; line-height: 1.5;\">${escapedMessage.replace(/\\n/g, '<br>')}</div>`;\n\nreturn {\n  ...currentItem,\n  lastMessage: lastMessage,\n  lastMessageHTML: lastMessageHTML\n};"
      },
