    {
      "parameters": {
        "jsCode": "// Collecter résultats batch — structure Zone A→E v8\nconst allItems = $input.all();\n\nreturn allItems.map(item => {\n  const d = item.json;\n\n  const isDoublon      = !!(d._hashDoublon || d._isDoublon || d._empreinteDoublon);\n  const isFiscal       = !!(d._isFiscal);\n  const needsValidation = d.flag_mixte === true\n    || (d.confiance || '').toUpperCase() === 'BASSE';\n\n  const statut = isDoublon       ? 'DOUBLON'\n               : needsValidation ? 'EN_ATTENTE'\n               : isFiscal        ? 'FISCAL'\n               : 'ARCHIVE';\n\n  return {\n    json: {\n      // Zone A\n      Date:                 d.date           || '',\n      Emetteur:             d.emetteur       || '',\n      Type_Document:        d.type_document  || '',\n      Beneficiaire:         d.beneficiaire   || '',\n      Objet:                d.objet          || '',\n      // Zone B\n      Categorie:            d.categorie      || '',\n      Sous_Categorie:       d.sous_categorie || '',\n      Confiance:            d.confiance      || '',\n      Raison_Doute:         d.raison_doute   || '',\n      Mention_Manuscrite:   d.mention_manuscrite || '',\n      // Zone C\n      Montant_TTC:          d.montant_ttc    || 0,\n      Est_Financier:        d.est_financier  ?? '',\n      Flag_Mixte: (d.Flag_Mixte === true || d.Flag_Mixte === 'true' || d.Flag_Mixte === 'TRUE') ? true : false,\n      Montant_Pro_Estime:   d.montant_pro_estime   ?? '',\n      Montant_Perso_Estime: d.montant_perso_estime ?? '',\n      Ratio_Pro_Pct:        d.ratio_pro_pct         ?? '',\n      // Zone D — vide intentionnellement\n      Est_Valide_Mixte:     '',\n      Montant_Pro_Valide:   '',\n      // Zone E\n      Source:               'BATCH',\n      File_Name:            d._fileName || d.clean_filename || '',\n      Lien_Drive:           d._driveLink || '',\n      Empreinte:            d._empreinte || '',\n      Hash:                 d._hash      || '',\n      Gmail_Id:             d._gmailId   || '',\n      File_Id:              d._fileId    || d.fileId || '',\n      // Statut batch\n      statut: statut\n    }\n  };\n});"
      },
