        "jsCode": "// Filtrer uniquement les fileIds traités avec succès\n// DOUBLON / EN_ATTENTE / ERREUR restent dans _INBOX_BATCH intentionnellement\nconst aSupprimer = $('📝 Préparer Rapport').first().json._aSupprimer || [];\n\nif (aSupprimer.length === 0) {\n  throw new Error('NETTOYAGE_VIDE: Aucun fichier à supprimer de _INBOX_BATCH');\n}\n\nconsole.log(`🧹 Nettoyage _INBOX_BATCH: ${aSupprimer.length} fichiers à supprimer`);\n\nreturn aSupprimer.map(fileId => ({ json: { fileId } }));"
      },
