    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst total    = items.length;\nconst doublons = items.filter(i => i.json.Statut === 'DOUBLON').length;\nconst fiscaux  = items.filter(i => i.json.Statut === 'FISCAL').length;\nconst archives = items.filter(i => i.json.Statut === 'ARCHIVE').length;\nconst attente  = items.filter(i => i.json.Statut === 'EN_ATTENTE').length;\nconst erreurs  = items.filter(i => i.json.Statut === 'ERREUR').length;\n\n// Fichiers à purger : FISCAL + ARCHIVE seulement\nconst aSupprimer = items\n  .filter(i => ['FISCAL','ARCHIVE'].includes(i.json.Statut))\n  .map(i => i.json.File_Id)\n  .filter(Boolean);\n\n// Récupérer le chatId transmis par le Commander\nconst chatId = $('⚙️ Init Paramètres').first().json.chatId\n             || $env.GED_TELEGRAM_CHAT_ID\n             || '';\n\nconst now = new Date().toLocaleString('fr-CA', { timeZone: 'America/Toronto' });\n\nconst report = [\n  '📦 *GED BATCH — Rapport final*',\n  `🕐 ${now}`,\n  '',\n  `✅ Fiscaux archivés  : \\`${fiscaux}\\``,\n  `🗄️ Archives GED     : \\`${archives}\\``,\n  `🚫 Doublons ignorés : \\`${doublons}\\``,\n  `⏳ En attente valid.: \\`${attente}\\``,\n  `❌ Erreurs          : \\`${erreurs}\\``,\n  `📄 Total traité     : \\`${total}\\``,\n  `🧹 Fichiers à purger: \\`${aSupprimer.length}\\``,\n  '',\n  attente > 0\n    ? `_⚠️ ${attente} document(s) en attente de validation — consulter _REVUE_BATCH._`\n    : erreurs > 0\n    ? '_Vérifier les exécutions n8n pour les erreurs._'\n    : '_Tous les documents ont été traités avec succès. ✓_'\n].join('\\n');\n\nreturn [{ json: {\n  report, total, doublons, fiscaux, archives, attente, erreurs,\n  chatId,\n  _aSupprimer: aSupprimer\n}}];"
      },
