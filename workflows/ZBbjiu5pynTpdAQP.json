      "parameters": {
        "jsCode": "// Pacer — délai inter-requêtes Gemini (15 RPM max)\nconst SECONDS_BETWEEN_REQUESTS = 5;\nawait new Promise(resolve => setTimeout(resolve, SECONDS_BETWEEN_REQUESTS * 1000));\nreturn $input.all().map(item => ({ json: item.json }));"
