    {
      "parameters": {
        "jsCode": "// Filtrer PDF/images, exclure dossiers, indexer\nconst TYPES = ['pdf','jpg','jpeg','png','heic','webp'];\nconst items = $input.all();\n\nconst files = items[0].json.files || [];\nconsole.log('Nombre de fichiers listés par HTTP Request:', files.length);\n\nconst filtered = files.filter(file => {\n  const mime = file.mimeType || '';\n  const name = file.name    || '';\n  if (mime === 'application/vnd.google-apps.folder') return false;\n  return TYPES.some(t => mime.includes(t))\n      || new RegExp(`\\\\.(${TYPES.join('|')})$`,'i').test(name);\n});\n\nconst total = filtered.length;\nconsole.log(`GED_BATCH: ${total} fichiers détectés dans _INBOX_BATCH`);\n\nif (total === 0) throw new Error('_INBOX_BATCH vide — rien à traiter');\n\nreturn filtered.map((file, i) => ({\n  json: {\n    fileId:      file.id,\n    fileName:    file.name,\n    fileUrl:     file.webViewLink || '',\n    source:      'BATCH',\n    _batchIndex: i + 1,\n    _batchTotal: total\n  }\n}));"
      },
