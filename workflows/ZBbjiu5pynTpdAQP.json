    {
      "parameters": {
        "jsCode": "function generateBatchId() {\n  const now = new Date();\n  const ts = now.toISOString().slice(0, 19).replace(/[-:]/g, '');\n  return 'batch_' + ts;\n}\n\nfunction getNatureFinale(flags) {\n  if (flags.isDoublon) return 'DOUBLON';\n  if (flags.isFiscal) return 'FISCAL';\n  if (flags.flagMixte) return 'MIXTE';\n  return 'GED';\n}\n\nfunction getActionRequise(statut, confiance, flagMixte, estValide) {\n  if (statut === 'DOUBLON') return 'VERIFIER';\n  if (statut === 'EN_ATTENTE') {\n    if (flagMixte) return 'VENTILER';\n    if ((confiance || '').toUpperCase() === 'BASSE') return 'VALIDER';\n    return 'VERIFIER';\n  }\n  if (statut === 'FISCAL') return estValide === true ? 'ARCHIVER' : 'VALIDER';\n  if (estValide === true) return 'RIEN';\n  return 'VALIDER';\n}\n\nconst allItems = $input.all();\nconst batchId = generateBatchId();\nconst batchTotal = allItems.length;\nconst now = new Date().toLocaleString('fr-CA', {\n  timeZone: 'America/Toronto',\n  year: 'numeric', month: '2-digit', day: '2-digit',\n  hour: '2-digit', minute: '2-digit', second: '2-digit'\n});\n\nreturn allItems.map((item, index) => {\n  const d = item.json;\n\n  const isDoublon = !!(d._hashDoublon || d._isDoublon || d._empreinteDoublon);\n  const isFiscal  = !!(d._isFiscal);\n  const flagMixte = d.flag_mixte === true || d.Flag_Mixte === true ||\n                    d.flag_mixte === 'true' || d.Flag_Mixte === 'true';\n  const needsValidation = flagMixte || (d.confiance || '').toUpperCase() === 'BASSE';\n\n  const statut = isDoublon       ? 'DOUBLON'\n               : needsValidation ? 'EN_ATTENTE'\n               : isFiscal        ? 'FISCAL'\n               : 'ARCHIVE';\n\n  const natureFinal   = getNatureFinale({ isDoublon, isFiscal, flagMixte });\n  const actionRequise = getActionRequise(statut, d.confiance || '', flagMixte, d._estValide === true);\n\n  return {\n    json: {\n      Batch_Id:           batchId,\n      Batch_Index:        index + 1,\n      Batch_Total:        batchTotal,\n      Ts_Traitement:      now,\n      File_Name:          d._fileName || d.clean_filename || '',\n      Lien_Drive:         d._driveLink || '',\n      Statut:             statut,\n      Nature_Finale:      natureFinal,\n      Confiance:          d.confiance || '',\n      Raison_Doute:       d.raison_doute || '',\n      Flag_Mixte:         flagMixte,\n      Action_Requise:     actionRequise,\n      Est_Valide_Mixte:   d._estValide === true ? true : '',\n      Montant_Pro_Valide: d.montant_pro_valide !== undefined ? d.montant_pro_valide : '',\n      Montant_TTC:        d.montant_ttc || 0,\n      Source:             'BATCH',\n      File_Id:            d._fileId || d.fileId || '',\n      Empreinte:          d._empreinte || ''\n    }\n  };\n});"
      },
