      "parameters": {
        "jsCode": "// Fusionner les entrées du Manuel et du Execute Workflow Trigger\n// Le chatId et fromUser viennent du Commander via Execute Workflow\n// En mode Manuel ils sont absents (on utilise l'env var fallback)\nconst input = $input.first().json || {};\n\nconst chatId = input.chatId || $env.GED_TELEGRAM_CHAT_ID || '';\nconst fromUser = input.fromUser || 'Manuel';\nconst limit = input.limit ? parseInt(input.limit) : null;\n\nreturn [{ json: { chatId, fromUser, limit } }];"
      },
